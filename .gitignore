# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Database and storage files
*.heap
*.db
*.bin

# Datos generados en tiempo de ejecución (el frontend corre en modo demo
# y limpia esta carpeta al iniciar)
demo_data/
generated_sql/

# Datasets espaciales generados (Parte 2): se regeneran con
# benchmarks/generate_spatial_datasets.py
datasets/spatial/generated/

# Salidas de benchmarks que no forman parte de los resultados oficiales:
# corridas de prueba y registros de consola (los datos están en los CSV).
benchmarks/results/smoke/
benchmarks/results/*_progress.log
benchmarks/results/*_console.txt

# PDF del informe generado localmente (la fuente es docs/informe.md)
docs/informe.pdf

# Pruebas
.pytest_cache/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

test_manual.py
